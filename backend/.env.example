# Backend environment variables example
# Copy to .env and fill values before running the server

# Server
PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (either DATABASE_URL or individual PG_* vars)
# Option A: Full connection string
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B: Individual connection fields
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_DATABASE=dravyantra
PG_PORT=5432

# Firebase service account (if used)
# If you use Firebase Admin with a service account JSON file, set the path:
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
